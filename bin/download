#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=/dev/null
source "${plugin_dir}/lib/utils.bash"

# Download and extract in a scratch dir first so a failed download leaves no
# files behind in ASDF_DOWNLOAD_PATH.
scratch_dir=$(mktemp -d)
trap 'rm -rf "$scratch_dir"' EXIT

release_file="$scratch_dir/$TOOL_NAME.tar.gz"
download_release "$ASDF_INSTALL_VERSION" "$release_file"

mkdir "$scratch_dir/extract"
tar -xzf "$release_file" -C "$scratch_dir/extract" || fail "Could not extract $release_file"

mkdir -p "$ASDF_DOWNLOAD_PATH"
mv "$scratch_dir/extract/"* "$ASDF_DOWNLOAD_PATH/"
